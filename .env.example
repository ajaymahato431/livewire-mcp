# ─────────────────────────────────────────────────────────────────────────────
# livewire-mcp configuration
#
# Copy this file to `.env` and edit as needed:
#     cp .env.example .env
#
# Every value here is optional — the server runs with sensible defaults and no
# .env file at all. No credentials are required.
#
# Precedence: CLI flag  >  environment variable  >  default below.
# So `livewire-mcp --timeout 30000` overrides REQUEST_TIMEOUT_MS.
#
# When launched by an MCP client, prefer the client's own `env` block — it is
# applied before this file and always wins.
# ─────────────────────────────────────────────────────────────────────────────


# ─── Documentation source ────────────────────────────────────────────────────

# Which Livewire docs version to read pages from on livewire.laravel.com.
# Flag: --docs-version
LIVEWIRE_DOCS_VERSION=4.x

# Which ref of the livewire/livewire repository supplies the page index
# (docs/__nav.md) and the fallback used when the docs site is unreachable.
# Flag: --github-ref
LIVEWIRE_GITHUB_REF=main


# ─── Authentication (optional) ───────────────────────────────────────────────

# A GitHub token is NOT required. The index is read from raw.githubusercontent.com,
# which is not rate limited the way the api.github.com endpoint used in v1 was.
#
# Set this only if you share an outbound IP with heavy GitHub traffic and start
# seeing 429 responses. A read-only token with no scopes is sufficient.
#
# There is deliberately no CLI flag for this: a token passed as a flag is visible
# to anyone who can list running processes.
#
# Never commit a real value. This file is a template; `.env` is git-ignored.
GITHUB_TOKEN=


# ─── Network ─────────────────────────────────────────────────────────────────

# Per-request timeout in milliseconds. Raise it on a slow or filtered network.
# Flag: --timeout
REQUEST_TIMEOUT_MS=15000

# Retry attempts for transient failures (429, 500, 502, 503, 504, timeouts).
# Retries use exponential backoff and honour any Retry-After header.
# Flag: --retries
REQUEST_RETRIES=2


# ─── Caching ─────────────────────────────────────────────────────────────────
# Documents are cached in memory only, for the lifetime of the process.
# Nothing is written to disk.

# Maximum cached documents before the least recently used one is evicted.
# Flag: --cache-max
CACHE_MAX_ENTRIES=100

# How long a fetched page stays fresh, in milliseconds. Default 3 hours.
# Flag: --doc-ttl
DOC_TTL_MS=10800000

# How long the page index stays fresh. Default 6 hours.
# Flag: --index-ttl
INDEX_TTL_MS=21600000

# How long a *failed* fetch is remembered before it is retried. Default 1 minute.
# Flag: --negative-ttl
NEGATIVE_TTL_MS=60000


# ─── Search ──────────────────────────────────────────────────────────────────

# Default number of results from search_livewire_docs when the caller does not
# pass maxResults.
# Flag: --max-results
SEARCH_MAX_RESULTS=5
